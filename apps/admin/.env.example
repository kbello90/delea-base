# Browser-exposed config (Vite only exposes VITE_* vars). Copy to .env.local (gitignored).
# Only the public anon key belongs here — never the service role key.
#
# Local development: take the values from the LOCAL stack only
#   npx supabase@2.121.0 status -o env
#   API_URL  -> VITE_SUPABASE_URL      (http://127.0.0.1:55321)
#   ANON_KEY -> VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
# Public base URL of the brand-assets bucket (logos). Empty: derived from VITE_SUPABASE_URL.
VITE_BRAND_ASSETS_BASE_URL=
