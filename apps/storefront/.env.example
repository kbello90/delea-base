# Browser-exposed config (Vite only exposes VITE_* vars). Copy to .env.local.
# Only the public anon key belongs here — never the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
# Cloudflare Turnstile site key (public) for the checkout widget. Empty locally: no widget.
VITE_TURNSTILE_SITE_KEY=
