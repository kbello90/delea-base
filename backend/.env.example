# Backend settings. Copy to backend/.env (gitignored) and fill in. Never commit real keys.
#
# Local development against the local Supabase stack (supabase/config.toml ports):
# get the values from `npx supabase@2.121.0 status -o env` and map them like this:
#   API_URL          -> SUPABASE_URL
#   ANON_KEY         -> SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY
#   DB_URL           -> DATABASE_URL
#
# SUPABASE_URL=http://127.0.0.1:55321
# SUPABASE_ANON_KEY=<ANON_KEY from supabase status>
# SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from supabase status>
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
#
# Comma-separated exact origins allowed by CORS (no wildcard). Default: the two local apps.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public base URL of the product-images bucket (image URL = this + stored path). Empty: derived
# from SUPABASE_URL (right for the local stack). Hosted: the project's or a CDN's bucket URL.
PRODUCT_IMAGES_BASE_URL=
# Public base URL of the brand-assets bucket (logos), the same way. Empty: derived.
BRAND_ASSETS_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LLM_API_KEY=
# Cloudflare Turnstile secret for the storefront checkout. Outside ENVIRONMENT=local/test an
# empty value turns checkout off (fails closed); locally, empty skips the check.
TURNSTILE_SECRET_KEY=
