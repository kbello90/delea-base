# Node / frontend
node_modules/
dist/
.turbo/
*.tsbuildinfo
.vite/

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Python / backend
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Bicep build output (compiled ARM JSON)
infra/bicep/**/*.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Showcase: only the product list and its README are committed. The photos stay outside the
# repository (SHOWCASE_DIR); backend/tests/test_showcase.py checks this.
showcase/*
!showcase/products.yaml
!showcase/README.md

# End-to-end run (local only)
e2e/.shop.json
e2e/test-results/
e2e/screenshots/
e2e/playwright-report/
