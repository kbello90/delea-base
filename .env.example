# Backend environment (backend/ reads these). Copy to .env and fill in locally.
# Never commit real values. Enterprise tenants differ only in these values (TRD §2.3).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# ---- Stripe (Slice B2, test mode only; see README "Stripe sandbox") ----
# Your sandbox's TEST secret key (sk_test_...). Empty: card payments are off.
# A live key (sk_live_ / rk_live_) stops the API at startup. SECRET: never commit it.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...): locally the value printed by `stripe listen --print-secret`.
# Empty: the webhook answers 503. SECRET: never commit it.
STRIPE_WEBHOOK_SECRET=
# Optional: "stripe" (default) or "fake" (the local end-to-end run only; refused elsewhere).
STRIPE_GATEWAY=
# Optional: where Stripe onboarding returns the owner (the admin app). Default http://localhost:5173.
ADMIN_APP_URL=
LLM_API_KEY=
# Cloudflare Turnstile secret for the storefront checkout. Outside ENVIRONMENT=local/test an
# empty value turns checkout off (fails closed); locally, empty skips the check.
TURNSTILE_SECRET_KEY=
